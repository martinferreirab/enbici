# Plantilla de configuración del backend. Copiar a `.env` (gitignored, chmod 600) y completar.
# En AWS los valores vienen de SSM Parameter Store, no de este archivo.
# Variables ya exportadas en la shell / systemd tienen prioridad sobre `.env`.

# --- Entorno ---------------------------------------------------------------
# development | production. En production: ENBICI_JWT_SECRET obligatorio y /docs deshabilitado.
ENBICI_ENV=development

# --- Secretos ---------------------------------------------------------------
# Firma de los JWT. Generar con: python3 -c "import secrets; print(secrets.token_hex(32))"
# En development, si falta, se autogenera en $ENBICI_STATE_DIR/.jwt_secret.
ENBICI_JWT_SECRET=

# OAuth client_credentials de la API de transporte de la IM (ómnibus en vivo).
# Opcionales: sin ellas /route funciona igual, sin penalización por ómnibus.
MONTEVIDEO_CLIENT_ID=
MONTEVIDEO_CLIENT_SECRET=

# --- Servidor (no secretos) --------------------------------------------------
# 0.0.0.0 para probar desde el celular en la LAN; 127.0.0.1 detrás de Caddy en AWS.
ENBICI_HOST=0.0.0.0
ENBICI_PORT=8000
# Orígenes CORS separados por coma. La app nativa no usa CORS; solo afecta a clientes web.
ENBICI_CORS_ORIGINS=*
# Carpeta para lo que el server escribe en runtime: enbici.db, consultas_rutas.csv, .jwt_secret.
# Default: <repo>/data. En AWS: /var/lib/enbici (un solo lugar para backups).
ENBICI_STATE_DIR=
# Intentos de /login y /register permitidos por IP en la ventana (segundos).
ENBICI_AUTH_RATE_LIMIT=10
ENBICI_AUTH_RATE_WINDOW_S=60

# --- Streamlit ---------------------------------------------------------------
ENBICI_API_URL=http://localhost:8000
